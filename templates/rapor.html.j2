<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Makro Pano · {{ tarih }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
{% include "_stil.html.j2" %}
</head>
<body>
<div class="wrap">

<header class="top">
  <div>
    <span class="badge b-acc">Makro Pano</span>
    <h1 style="margin-top:10px">{{ cfg.rapor.baslik }}</h1>
    <div class="sub" style="margin:4px 0 0">{{ cfg.rapor.alt_baslik }}</div>
  </div>
  <div class="meta">
    <div style="font-weight:600;color:var(--ink)">{{ tarih|trdate }}</div>
    <div>Üretim {{ uretim }} TSİ · {{ yorum.kaynak }}</div>
    <div><a href="arsiv/index.html" style="color:var(--acc)">Arşiv →</a>{% if hisse_url %} · <a href="{{ hisse_url }}" style="color:var(--acc)">Hisse raporu →</a>{% endif %}</div>
    <button class="theme-btn" id="themeBtn" type="button">Tema</button>
  </div>
</header>

<!-- REJİM -->
<section class="hero">
  <div class="gauges">
  <div class="card gauge">
    <div class="sec-no">MAKRO REJİM</div>
    <div class="n">{{ a.regime.skor }}<small>/100</small></div>
    <div style="font-weight:600;margin-top:4px">{{ a.regime.etiket }}</div>
    <div class="meter"><i style="left:{{ a.regime.skor }}%"></i></div>
    <div class="meter-l"><span>Risk kapalı</span><span>Nötr</span><span>Risk açık</span></div>
  </div>
  {% if t %}
  <div class="card gauge">
    <div class="sec-no">TEKNİK SAĞLIK</div>
    <div class="n">{{ t.saglik.skor }}<small>/100</small></div>
    <div style="font-weight:600;margin-top:4px">{{ t.saglik.etiket }}</div>
    <div class="meter"><i style="left:{{ t.saglik.skor }}%"></i></div>
    <div class="meter-l"><span>Zayıf</span><span>Kararsız</span><span>Güçlü</span></div>
  </div>
  {% endif %}
  </div>
  <div class="card">
    <div class="pillars">
      {% for p in a.regime.ayaklar %}
      <div class="pillar">
        <div class="t">{{ p.ad }}</div>
        <div class="v {{ 'pos' if p.skor>=60 else ('neg' if p.skor<40 else '') }}">{{ p.skor }} <span style="font:500 12px Inter;color:var(--muted)">· {{ p.etiket }}</span></div>
        <div class="bar"><b style="width:{{ p.skor }}%;background:{{ 'var(--pos)' if p.skor>=60 else ('var(--neg)' if p.skor<40 else 'var(--warn)') }}"></b></div>
      </div>
      {% endfor %}
    </div>
    <div class="summary">{{ yorum.ozet }}</div>
  </div>
</section>

<!-- 01 HIZLI BAKIŞ -->
<section class="sec">
  <div class="sec-no">01</div>
  <h2>Hızlı Bakış</h2>
  <p class="sub">Ana göstergeler · bir önceki kapanışa göre değişim · son 90 gün</p>
  <div class="grid tiles">
    {% for m in hizli %}
    <div class="card tile">
      <div class="k"><span>{{ m.ad }}</span>{% if m.bayat %}<span class="badge b-warn">bayat</span>{% endif %}</div>
      {% if m.ok %}
      <div class="v">{{ m|val }}</div>
      <div class="c {{ m|tone }}">{{ m|chg }}</div>
      <span class="{{ m|tone }}">{{ spark(m.spark)|safe }}</span>
      {% else %}<div class="v neu">—</div><div class="c neu">veri yok</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<!-- 02 HİKAYE -->
<section class="sec">
  <div class="sec-no">02</div>
  <h2>Makro Hikaye</h2>
  <p class="sub">Günün ana tablosu · uyarılar kurallardan, yorum {{ yorum.kaynak }} tarafından</p>
  <div class="grid two">
    <div class="card">
      <ul class="story">{% for h in yorum.hikaye %}<li>{{ h }}</li>{% endfor %}</ul>
      {% if manuel.notlar %}
      <div class="note"><b>Bu hafta:</b> {% for n in manuel.notlar %}{{ n }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
      {% endif %}
    </div>
    <div class="grid" style="align-content:start">
      {% for al in a.alerts[:6] %}
      <div class="card alert {{ al.tur }}">
        <span class="badge {{ {'YÜKSEK':'b-risk','ORTA':'b-warn','DÜŞÜK':'b-muted','DESTEK':'b-ok'}[al.seviye] }}">{{ al.seviye }}</span>
        <h3>{{ al.baslik }}</h3><p>{{ al.metin }}</p>
      </div>
      {% else %}<div class="card"><p class="neu" style="margin:0">Kırmızı sinyal veya olağandışı hareket yok.</p></div>
      {% endfor %}
    </div>
  </div>
</section>


{% if t %}
<!-- 03 TEKNİK GÖRÜNÜM -->
<section class="sec">
  <div class="sec-no">03</div>
  <h2>Teknik Görünüm</h2>
  <p class="sub">Piyasa sağlık skoru {{ t.saglik.skor }}/100 · {% for k, v in t.saglik.ayaklar.items() %}{{ k }} %{{ v.agirlik }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
  <div class="chips">
    {% for k, v in t.saglik.ayaklar.items() %}
    <div class="chip {{ 'g' if v.puan>=7 else ('r' if v.puan<4 else 'y') }}">{{ k }}: <b>{{ v.puan|num(1) }}/10</b><small>{{ v.not }}</small></div>
    {% endfor %}
    <div class="chip {{ 'y' if t.takvim.pencere_acik else '' }}">Vade Penceresi: <b>{{ 'Açık' if t.takvim.pencere_acik else 'Kapalı' }}</b>
      <small>Opsiyon vadesine {{ t.takvim.opex_is_gunu }} iş günü ({{ t.takvim.opex|sdate }})</small></div>
  </div>
  {% if yorum.teknik %}<div class="card" style="margin-top:12px"><p style="margin:0">{{ yorum.teknik }}</p></div>{% endif %}

  <div class="card" style="margin-top:12px">
    <div class="scroll"><table class="tbl">
      <thead><tr><th>Endeks</th><th>Fiyat</th><th>Gün</th><th>1 Ay</th><th>10G</th><th>21G</th><th>50G</th><th>200G</th><th>RSI</th><th>Evre</th></tr></thead>
      <tbody>{% for r in t.endeksler %}
      <tr><td class="l"><b>{{ r.sembol }}</b></td><td class="mono">{{ r.fiyat|num(2) }}</td>
        <td class="mono {{ r.gun|pct_tone }}">{{ r.gun|spct(2) }}</td><td class="mono {{ r.ay|pct_tone }}">{{ r.ay|spct }}</td>
        {% for n in (10, 21, 50, 200) %}<td class="mono {{ 'pos' if n in r.ma_ust else 'neg' }}">{{ r.ma[n]|num(2) }}</td>{% endfor %}
        <td class="mono">{{ r.rsi|num(0) }}</td>
        <td><span class="badge {{ {1:'b-muted',2:'b-ok',3:'b-warn',4:'b-risk'}[r.evre] }}">{{ r.evre_ad }}</span></td></tr>
      {% endfor %}</tbody>
    </table></div>
    <p class="src">Yeşil ortalama: fiyat üstünde · kırmızı: altında. Evre = Weinstein evresi (150 günlük ortalama ve eğimi).</p>
  </div>

  <div class="grid charts" style="margin-top:12px">
    {% for g in t.grafikler %}
    <div class="card">
      <div style="display:flex;justify-content:space-between;gap:8px"><b>{{ g.sembol }}</b>
        <span class="mono">{{ g.fiyat|num(2) }} <span class="{{ g.gun|pct_tone }}">{{ g.gun|spct(2) }}</span></span></div>
      <div class="legend"><span><i style="background:var(--ink)"></i>Fiyat</span>
        {% for k, c in (('10G','--c1'),('21G','--c2'),('50G','--c3'),('200G','--c4')) %}<span><i style="background:var({{ c }})"></i>{{ k }} {{ g.son[k]|num(2) }}</span>{% endfor %}</div>
      {{ line_chart(g.seriler)|safe }}
      <div class="meter-l"><span>{{ g.ilk_tarih }}</span><span>{{ g.orta_tarih }}</span><span>{{ g.son_tarih }}</span></div>
      <p class="okuma"><b>Okuma:</b> {{ g.okuma }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<!-- 04 ROTASYON -->
<section class="sec">
  <div class="sec-no">04</div>
  <h2>Rotasyon Radarı</h2>
  <p class="sub">Sektör ve tema ETF'lerinin SPY'ye göre göreli gücü · sağ üst: lider, sol üst: güçlenen, sol alt: geride, sağ alt: zayıflayan</p>
  <div class="grid rrgwrap">
    <div class="card">{{ rrg(t.rotasyon)|safe }}</div>
    <div class="card"><div class="scroll"><table class="tbl">
      <thead><tr><th>ETF</th><th>Skor</th><th>Kadran</th><th>vs SPY 1A</th><th>3A</th><th>Evre</th></tr></thead>
      <tbody>{% for r in t.rotasyon %}
      <tr><td class="l"><b>{{ r.sembol }}</b></td><td class="mono">{{ r.skor }}</td>
        <td><span class="badge {{ {'lider':'b-ok','gucl':'b-acc','zayif':'b-warn','geride':'b-risk'}[r.kadran] }}">{{ r.kadran_ad }}</span></td>
        <td class="mono {{ r.rel_1a|pct_tone }}">{{ r.rel_1a|spct }}</td><td class="mono {{ r.rel_3a|pct_tone }}">{{ r.rel_3a|spct }}</td>
        <td class="mono neu" style="font-size:12px">{{ r.evre_ad.split(' · ')[0] }}</td></tr>
      {% endfor %}</tbody>
    </table></div></div>
  </div>
</section>

<!-- 05 HACİM -->
<section class="sec">
  <div class="sec-no">05</div>
  <h2>İşlem Hacmi</h2>
  <p class="sub">Son seans hacmi · 20 günlük medyana oranı · kesik çizgi = medyan</p>
  <div class="card alert {{ {'pos':'destek','neg':'risk','neu':'hareket'}[t.hacim.ton] }}" style="margin-bottom:12px"><b>Sonuç:</b> {{ t.hacim.sonuc }}</div>
  <div class="grid vols">
    {% for v in t.hacim.kalemler %}
    <div class="card tile">
      <div class="k"><span>{{ v.ad }}{% if v.genel %} · piyasa geneli{% endif %}</span><span>{{ v.tarih|sdate }}</span></div>
      <div class="v">{{ v.hacim|big }}</div>
      <div class="c {{ v.degisim|pct_tone }}">{{ v.degisim|spct(1) }} önceki güne göre</div>
      <div class="c {{ 'pos' if v.oran and v.oran>=120 else ('neg' if v.oran and v.oran<80 else 'neu') }}" style="margin-top:6px">Normalin %{{ v.oran }}'i</div>
      {{ bars(v.bars, v.medyan)|safe }}
    </div>
    {% endfor %}
  </div>
  <p class="src">Yahoo'da son seansın endeks hacmi gün içinde kesinleşmemiş olabilir; rapor sabah üretildiği için genelde tamdır.</p>
</section>

<!-- 06 RİSK MODU -->
<section class="sec">
  <div class="sec-no">06</div>
  <h2>Risk Modu · Takvim · Bilanço</h2>
  <p class="sub">Momentum faktör stresi, oynaklık yapısı, vade/FOMC takvimi ve bilanço sezonu</p>
  <div class="grid sc">
    <div class="card">
      <b>Momentum faktör stresi</b>
      {% if t.momentum_stres %}{% set ms = t.momentum_stres %}
      <div class="kv"><span>MTUM 60g oynaklık</span><span class="mono">%{{ ms.mtum_vol|num(1) }}</span></div>
      <div class="kv"><span>SPY 60g oynaklık</span><span class="mono">%{{ ms.spy_vol|num(1) }}</span></div>
      <div class="kv"><span>Oran</span><span class="mono"><b>{{ ms.oran|num(2) }}</b> <span class="badge {{ {'normal':'b-ok','yüksek':'b-warn','aşırı stres':'b-risk'}[ms.etiket] }}">{{ ms.etiket }}</span></span></div>
      <p class="src">Eşikler: yüksek ≥ {{ ms.esikler.yuksek }}, aşırı ≥ {{ ms.esikler.asiri }}. Yüksek oran, kalabalık momentum hisselerinde ani ters dönüş riskine işaret eder.</p>
      {% else %}<p class="neu">Veri yok</p>{% endif %}
    </div>
    <div class="card">
      <b>Oynaklık & takvim</b>
      {% if t.vix %}
      <div class="kv"><span>VIX</span><span class="mono">{{ t.vix.vix|num(2) }}</span></div>
      {% if t.vix.vix3m %}<div class="kv"><span>VIX 3 ay</span><span class="mono">{{ t.vix.vix3m|num(2) }}</span></div>
      <div class="kv"><span>VIX / VIX3M</span><span class="mono">{{ t.vix.oran|num(2) }} · {{ t.vix.yapi }}</span></div>{% endif %}
      {% endif %}
      <div class="kv"><span>{{ 'Çeyreklik (üçlü) vade' if t.takvim.ceyreklik else 'Aylık opsiyon vadesi' }}</span><span class="mono">{{ t.takvim.opex|sdate }} · {{ t.takvim.opex_takvim_gunu }} gün</span></div>
      {% if t.takvim.fomc %}<div class="kv"><span>Sıradaki FOMC</span><span class="mono">{{ t.takvim.fomc|sdate }} · {{ t.takvim.fomc_gun }} gün</span></div>{% endif %}
    </div>
    <div class="card">
      <b>Bilanço sezonu</b> <span class="badge b-muted">manuel</span>
      {% set b = t.bilanco %}
      {% if b and b.hbk_tutturma is not none %}
      <div class="kv"><span>HBK tutturma</span><span class="mono">%{{ b.hbk_tutturma|num(1) }}{% if b.hbk_5y_ort %} <span class="neu">(5Y %{{ b.hbk_5y_ort|num(0) }})</span>{% endif %}</span></div>
      {% if b.ciro_tutturma is not none %}<div class="kv"><span>Ciro tutturma</span><span class="mono">%{{ b.ciro_tutturma|num(1) }}{% if b.ciro_5y_ort %} <span class="neu">(5Y %{{ b.ciro_5y_ort|num(0) }})</span>{% endif %}</span></div>{% endif %}
      {% if b.ceyrek_buyume is not none %}<div class="kv"><span>Çeyrek kâr büyümesi</span><span class="mono">%{{ b.ceyrek_buyume|num(1) }}{% if b.ceyrek_buyume_onceki is not none %} <span class="neu">(önce %{{ b.ceyrek_buyume_onceki|num(1) }})</span>{% endif %}</span></div>{% endif %}
      {% if b.fwd_fk is not none %}<div class="kv"><span>İleri 12A F/K</span><span class="mono">{{ b.fwd_fk|num(1) }}{% if b.fwd_fk_5y %} <span class="neu">(5Y {{ b.fwd_fk_5y|num(1) }})</span>{% endif %}</span></div>{% endif %}
      <p class="src">Kaynak: FactSet Earnings Insight · {{ b.kaynak_tarihi }} · manuel.yaml</p>
      {% else %}<p class="neu">manuel.yaml'da bilanço verisi yok.</p>{% endif %}
    </div>
  </div>
</section>

<!-- 07 İZLEME SIRASI -->
<section class="sec">
  <div class="sec-no">07</div>
  <h2>Bugünün İzleme Sırası</h2>
  <p class="sub">Kurallardan otomatik üretilen seviye ve olay listesi</p>
  <div class="card">
    {% for w in t.izleme %}
    <div class="wl"><span class="badge {{ {'YÜKSEK':'b-risk','ORTA':'b-warn','İZLEME':'b-acc'}[w.seviye] }}">{{ w.seviye }}</span><span>{{ w.metin }}</span></div>
    {% else %}<p class="neu" style="margin:0">Bugün öne çıkan teknik seviye yok.</p>{% endfor %}
  </div>
</section>
{% endif %}

<!-- 03 DEĞİŞENLER -->
<section class="sec">
  <div class="sec-no">08</div>
  <h2>Önceki rapordan bu yana</h2>
  <p class="sub">{% if onceki_tarih %}{{ onceki_tarih|trdate }} → {{ tarih|trdate }}{% else %}İlk kayıt{% endif %}</p>
  <div class="card"><ul class="story">{% for d in a.degisenler %}<li>{{ d }}</li>{% endfor %}</ul></div>
</section>

<!-- 04 SENARYOLAR -->
<section class="sec">
  <div class="sec-no">09</div>
  <h2>Eğer şu olursa</h2>
  <p class="sub">Eşikler config.yaml'da · çerçeveli kart şu an koşulu sağlanan senaryo</p>
  <div class="grid sc">
    {% for s in a.scenarios %}
    <div class="card scn {{ s.ton }} {{ 'active' if s.aktif }}">
      <span class="badge {{ {'up':'b-ok','base':'b-warn','down':'b-risk'}[s.ton] }}">{{ {'up':'Yukarı','base':'Baz','down':'Aşağı'}[s.ton] }}{% if s.aktif %} · aktif{% endif %}</span>
      <h3>{{ s.ad }}</h3>
      {% for k in s.kosullar %}
      <div class="cond"><span>{{ k.ad }} {% if k.op=='between' %}{{ k.esik[0]|num }}–{{ k.esik[1]|num }}{% else %}{{ k.op }} {{ k.esik|num }}{% endif %}</span>
        <span class="mono {{ 'pos' if k.saglandi else 'neu' }}">{{ k.mevcut|num }} {{ '✓' if k.saglandi else '' }}</span></div>
      {% endfor %}
      <p>{{ s.metin }}</p>
    </div>
    {% endfor %}
  </div>
  {% if yorum.izle %}<div class="note"><b>İzlenecek seviyeler:</b><ul class="story" style="margin-top:6px">{% for i in yorum.izle %}<li>{{ i }}</li>{% endfor %}</ul></div>{% endif %}
</section>

<!-- 05 PORTFÖY -->
<section class="sec">
  <div class="sec-no">10</div>
  <h2>Portföy · MODEL V7.0</h2>
  <p class="sub">Aday hisseler · kural işaretleri (tavsiye değil) · 3 aylık performans {{ a.portfolio.benchmark }}'ye göre</p>
  <div class="card">
    <div class="scroll"><table class="tbl">
      <thead><tr><th>Hisse</th><th>Fiyat</th><th>Gün</th><th>1 Ay</th><th>Zirveden</th><th>200G</th><th>RSI</th><th>vs {{ a.portfolio.benchmark }} 3A</th><th>90 gün</th><th>İşaretler</th></tr></thead>
      <tbody>
      {% for h in a.portfolio.hisseler %}{% if h.ok %}
      <tr>
        <td class="l">{% if hisse_url %}<a href="{{ hisse_url }}{{ h.sembol }}.html" style="color:var(--acc);text-decoration:none"><b>{{ h.sembol }} →</b></a>{% else %}<b>{{ h.sembol }}</b>{% endif %}<div style="font-size:12px;color:var(--muted)">{{ h.tema }}</div></td>
        <td class="mono">{{ h.fiyat|num(2) }}</td>
        <td class="mono {{ h.gun|pct_tone }}">{{ h.gun|spct(2) }}</td>
        <td class="mono {{ h.ay|pct_tone }}">{{ h.ay|spct }}</td>
        <td class="mono {{ 'neg' if h.zirveden < -a.portfolio.bolge else 'neu' }}">{{ h.zirveden|spct }}</td>
        <td class="mono {{ h.sma200_uzaklik|pct_tone }}">{{ h.sma200_uzaklik|spct }}</td>
        <td class="mono">{{ h.rsi|num(0) }}</td>
        <td class="mono {{ h.rel_3m|pct_tone }}">{{ h.rel_3m|spct }}</td>
        <td class="{{ h.ay|pct_tone }}">{{ spark(h.spark)|safe }}</td>
        <td><div class="flags">{% for t, txt in h.isaretler %}<span class="badge {{ {'zone':'b-acc','up':'b-ok','down':'b-risk','hot':'b-warn'}[t] }}">{{ txt }}</span>{% endfor %}</div></td>
      </tr>
      {% else %}<tr><td class="l"><b>{{ h.sembol }}</b></td><td colspan="9" class="neu">veri alınamadı</td></tr>{% endif %}{% endfor %}
      </tbody>
    </table></div>
    <div class="note"><b>DCA kuralı ({{ a.regime.etiket }}):</b> {{ a.portfolio.dca_notu }}</div>
    {% if yorum.portfoy %}<p style="margin:12px 0 0">{{ yorum.portfoy }}</p>{% endif %}
  </div>
</section>

<!-- 06 DETAY -->
<section class="sec">
  <div class="sec-no">11</div>
  <h2>Detay Panelleri</h2>
  <p class="sub">Tüm göstergeler · 1 yıllık aralıktaki konum · veri tarihi</p>
  <div class="tabs" role="tablist">
    {% for p in paneller %}<button role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-tab="p{{ loop.index }}">{{ p.ad }}</button>{% endfor %}
    <button role="tab" aria-selected="false" data-tab="psig">Sinyal Tablosu</button>
    {% if manuel.fedwatch %}<button role="tab" aria-selected="false" data-tab="pfed">FedWatch</button>{% endif %}
  </div>
  {% for p in paneller %}
  <div class="card tabpanel" id="p{{ loop.index }}" {% if not loop.first %}hidden{% endif %}>
    <div class="scroll"><table class="tbl">
      <thead><tr><th>Gösterge</th><th>Değer</th><th>Değişim</th><th>Önceki</th><th>1Y konum</th><th>Trend</th><th>Veri tarihi</th></tr></thead>
      <tbody>
      {% for m in p.satirlar %}
        {% if m.ok %}
        <tr><td class="l">{{ m.ad }}{% if m.bayat %} <span class="badge b-warn">bayat</span>{% endif %}</td>
          <td class="mono"><b>{{ m|val }}</b></td>
          <td class="mono {{ m|tone }}">{{ m|chg }}</td>
          <td class="mono neu">{{ m|val(m.onceki) if m.onceki is not none else '—' }}</td>
          <td><div class="range" title="1Y aralık {{ m.yil_min|num }} – {{ m.yil_max|num }}"><i style="left:{{ m.yil_konum }}%"></i></div></td>
          <td class="{{ m|tone }}">{{ spark(m.spark)|safe }}</td>
          <td class="mono neu">{{ m.tarih|sdate }}</td></tr>
        {% else %}<tr><td class="l">{{ m.ad }}</td><td colspan="6" class="neu">veri alınamadı</td></tr>{% endif %}
      {% endfor %}
      {% for d in p.turetilmis %}
        <tr><td class="l">{{ d.ad }} <span class="badge b-muted">hesaplanan</span></td>
          <td class="mono"><b>{{ d.deger|num }}{{ '' if d.birim in ('$mr',) else '' }}</b> <span class="neu" style="font-size:12px">{{ d.birim }}{% if d.detay %} · {{ d.detay }}{% endif %}</span></td>
          <td></td><td></td><td></td><td class="neu">{{ spark(d.spark or [])|safe }}</td><td class="mono neu">{{ d.tarih|sdate if d.tarih else 'güncel' }}</td></tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% if p.sektorler %}
    <h3 style="font-size:14px;margin:18px 0 6px">Sektör genişliği (1 aylık performansa göre)</h3>
    <div class="flags" style="justify-content:flex-start">
      {% for s in p.sektorler %}<span class="badge {{ 'b-ok' if s.ustunde else 'b-risk' }}">{{ s.sembol }} {{ s.ay|spct }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
  <div class="card tabpanel" id="psig" hidden>
    <div class="scroll"><table class="tbl">
      <thead><tr><th>Sinyal</th><th>Ayak</th><th>Değer</th><th>Yeşil eşik</th><th>Kırmızı eşik</th><th>Puan</th></tr></thead>
      <tbody>{% for s in a.regime.sinyaller %}
        <tr><td class="l">{{ s.ad }}</td><td class="neu">{{ s.ayak }}</td><td class="mono"><b>{{ s.deger|num }}</b></td>
          <td class="mono neu">{{ '<' if s.dusuk_iyi else '>' }} {{ s.yesil|num }}</td>
          <td class="mono neu">{{ '>' if s.dusuk_iyi else '<' }} {{ s.kirmizi|num }}</td>
          <td><span class="badge {{ {1:'b-ok',0:'b-warn',-1:'b-risk'}[s.puan] }}">{{ {1:'+1 yeşil',0:'0 sarı',-1:'−1 kırmızı'}[s.puan] }}</span></td></tr>
      {% endfor %}</tbody>
    </table></div>
    <p class="src">Rejim skoru = tüm sinyal puanlarının ortalaması, 0–100'e ölçeklenmiş. 60 ve üstü "Risk Açık", 40 altı "Risk Kapalı".</p>
  </div>
  {% if manuel.fedwatch %}
  <div class="card tabpanel" id="pfed" hidden>
    <div class="scroll"><table class="tbl">
      <thead><tr><th>Toplantı</th><th>İndirim</th><th>Sabit</th><th>Artırım</th></tr></thead>
      <tbody>{% for f in manuel.fedwatch %}
        <tr><td class="l mono">{{ f.toplanti }}</td><td class="mono pos">%{{ f.indirim|num(1) }}</td><td class="mono">%{{ f.sabit|num(1) }}</td><td class="mono neg">%{{ f.artirim|num(1) }}</td></tr>
      {% endfor %}</tbody>
    </table></div>
    <p class="src">Elle girildi · manuel.yaml · güncelleme {{ manuel.guncelleme }}{% if manuel_bayat %} <span class="badge b-warn">bayat</span>{% endif %}</p>
  </div>
  {% endif %}
</section>

<footer class="foot">
  Kaynaklar: FRED (St. Louis Fed), Yahoo Finance, elle girilen veriler (manuel.yaml). Tüm sayılar kod tarafından deterministik hesaplanır;
  yorum metni yalnızca bu sayılardan üretilir. Bayat etiketli veriler kaynağın yayın takviminden kaynaklanır.
  <br>Bu rapor kişisel kullanım içindir, yatırım tavsiyesi değildir.
</footer>
</div>
<script>
document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.tabs button').forEach(x=>x.setAttribute('aria-selected','false'));
  document.querySelectorAll('.tabpanel').forEach(x=>x.hidden=true);
  b.setAttribute('aria-selected','true');document.getElementById(b.dataset.tab).hidden=false;
}));
(function(){const r=document.documentElement,btn=document.getElementById('themeBtn');
  let t=null;try{t=localStorage.getItem('theme')}catch(e){}
  if(t)r.dataset.theme=t;
  btn.addEventListener('click',()=>{const dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
    r.dataset.theme=dark?'light':'dark';try{localStorage.setItem('theme',r.dataset.theme)}catch(e){}});})();
</script>
</body>
</html>
